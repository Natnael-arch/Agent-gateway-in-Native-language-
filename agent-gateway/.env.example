# Amharic Agent Gateway Configuration

# Server Port
PORT=3000

# Central Usage Proxy Base URL (Railway deployed URL or http://localhost:8787)
PROXY_BASE_URL=http://localhost:8787

# Central Usage Proxy Instance Bearer Token
PROXY_TOKEN=your_proxy_token_here

# Path to local Hermes binary
HERMES_BIN=/home/nate/.local/bin/hermes

# Set to true to test locally without calling external proxy endpoint
MOCK_TRANSLATION=false

