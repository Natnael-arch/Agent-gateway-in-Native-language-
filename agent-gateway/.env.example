# Amharic Agent Gateway Configuration

# Server Port
PORT=3000

# Addis AI API Key (Required for live translation)
ADDIS_API_KEY=your_addis_ai_api_key_here

# Addis AI Translate Endpoint URL
ADDIS_TRANSLATE_URL=https://api.addisassistant.com/api/v1/translate

# Path to local Hermes binary
HERMES_BIN=/home/nate/.local/bin/hermes

# Set to true to test locally without calling external Addis AI endpoint
MOCK_TRANSLATION=false
