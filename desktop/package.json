{
  "name": "agelgay-desktop",
  "version": "1.0.0",
  "description": "Agelgay Amharic AI Assistant Desktop Application",
  "homepage": "https://github.com/Natnael-arch/Agent-gateway-in-Native-language-",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:linux": "electron-builder build --linux",
    "build:win": "electron-builder build --win"
  },
  "author": {
    "name": "Agelgay",
    "email": "agelgay@users.noreply.github.com"
  },
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.agelgay.desktop",
    "productName": "Agelgay",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../agent-gateway",
        "to": "agent-gateway",
        "filter": [
          "**/*",
          "!.git/**",
          "!logs/**"
        ]
      }
    ],
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb",
        "dir"
      ],
      "category": "Utility",
      "synopsis": "Agelgay Amharic AI Assistant Desktop Application",
      "description": "Agelgay Amharic AI Assistant Desktop Application",
      "desktop": {
        "StartupWMClass": "Agelgay"
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
